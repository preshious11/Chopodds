# Copy to .env for local runs (never commit .env). On Railway, set these as
# service Variables instead.

# --- Required ---
# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=
# The Odds API key (https://the-odds-api.com) — primary odds provider
ODDS_API_KEY=

# --- Fallback odds providers (optional, used only if The Odds API fails) ---
# SharpAPI (https://sharpapi.io)
SHARPAPI_API_KEY=
# SportsGameOdds (https://sportsgameodds.com)
SPORTSGAMEODDS_API_KEY=

# --- Admin ---
# Your Telegram user ID; enables /status and /force_refresh_cache
ADMIN_CHAT_ID=

# --- Storage ---
# Where the odds cache, tracking DB, subscribers and logs are kept.
# On Railway, attach a volume and set this to its mount path (e.g. /data),
# otherwise all data is lost on every redeploy.
# DATA_DIR=/data

# --- Delivery ---
# Daily broadcast time, 24-hour format, Africa/Lagos timezone (default: 09:00)
DAILY_BROADCAST_TIME=09:00

# --- Odds fetching ---
# Provider order (default: the-odds-api,sharpapi,sportsgameodds)
# ODDS_PROVIDER_ORDER=the-odds-api,sharpapi,sportsgameodds
# The Odds API cost = regions x markets credits per league per day
# ODDS_REGIONS=uk
# ODDS_MARKETS=h2h,spreads,totals
# Seconds to wait before retrying after every provider failed (default: 600)
# ODDS_FETCH_RETRY_COOLDOWN=600

# --- Prediction quality ---
# MIN_PROBABILITY=0.50
# FALLBACK_PROBABILITY_FLOOR=0.40
# MIN_MATCHES_FOR_FULL_QUALITY=5
# MIN_BOOKMAKERS=3
# MAX_DAILY_PREDICTIONS=20
